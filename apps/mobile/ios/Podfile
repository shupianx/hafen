# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Hafen' do
  unless File.directory?(File.expand_path('../../../core/artifacts/ios/HafenCore.xcframework', __dir__))
    raise 'Missing Hafen core. Run npm run core:bootstrap and npm run core:ios from the repository root.'
  end
  unless File.directory?(File.expand_path('../../../core/artifacts/ios-host/HafenHost.xcframework', __dir__))
    raise 'Missing Hafen host. Run npm run core:ios:host from the repository root.'
  end
  pod 'HafenHost', :path => '../../../core'
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end

# The extension hosts only the native core; no React Native or JS runtime.
target 'HafenTunnel' do
  pod 'HafenCore', :path => '../../../core'
end
