<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="switchStyle">@style/HafenSwitch</item>
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    </style>

    <style name="HafenSwitch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="track">@drawable/hafen_switch_track</item>
        <item name="android:thumb">@drawable/hafen_switch_thumb</item>
        <item name="switchMinWidth">50dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="splitTrack">false</item>
    </style>

</resources>
